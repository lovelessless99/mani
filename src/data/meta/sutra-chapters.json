{
  "_note": "Per-sutra reading units. `unit` is the counter word shown in the UI (品 / 卷 / 部). Chapter ids are zero-padded and stable — progress is stored against them, so they must not be renumbered. 地藏經 is listed with its traditional 13 品 across 上中下三卷; 法華經 with the 28 品 of Kumarajiva's translation; 楞嚴經 by its 10 卷, which is how it is conventionally divided rather than by 品.",
  "heart-sutra": {
    "unit": "部",
    "items": [
      {
        "id": "001",
        "name": "般若波羅蜜多心經",
        "gist": "觀自在菩薩照見五蘊皆空,度一切苦厄;色即是空,空即是色。心無罣礙,遠離顛倒夢想,究竟涅槃。"
      }
    ]
  },
  "medicine-buddha": {
    "unit": "部",
    "items": [
      {
        "id": "001",
        "name": "藥師琉璃光如來本願功德經",
        "gist": "藥師如來十二大願,消災延壽、拔除病苦;聞名憶念,除病離苦,所求皆遂,得安樂利益。"
      }
    ]
  },
