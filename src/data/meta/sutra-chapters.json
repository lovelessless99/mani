  "diamond": {
    "unit": "分",
    "items": [
      {
        "id": "001",
        "name": "法會因由分",
        "gist": "敘法會緣起:佛於舍衛國乞食畢,敷座而坐。"
      },
      {
        "id": "002",
        "name": "善現啟請分",
        "gist": "須菩提請問:發菩提心者應云何住、云何降伏其心。"
      },
      {
        "id": "003",
        "name": "大乘正宗分",
        "gist": "佛示:滅度一切眾生而實無眾生得滅度,菩薩應離四相。"
      },
      {
        "id": "004",
        "name": "妙行無住分",
        "gist": "菩薩布施應無所住,不住色聲香味觸法,福德不可思量。"
      },
      {
        "id": "005",
        "name": "如理實見分",
        "gist": "不可以身相見如來;凡所有相,皆是虛妄。"
      },
      {
        "id": "006",
        "name": "正信希有分",
        "gist": "末世聞經能生信者,已於無量佛所種諸善根。"
      },
      {
        "id": "007",
        "name": "無得無說分",
        "gist": "如來所說法皆不可取、不可說,非法非非法。"
      },
      {
        "id": "008",
        "name": "依法出生分",
        "gist": "受持四句偈勝過七寶布施:一切佛法皆從此經出。"
      },
      {
        "id": "009",
        "name": "一相無相分",
        "gist": "須陀洹至阿羅漢四果,皆無「我得果」之念,方為真證。"
      },
      {
        "id": "010",
        "name": "莊嚴淨土分",
        "gist": "莊嚴佛土即非莊嚴;應無所住而生其心。"
      },
      {
        "id": "011",
        "name": "無為福勝分",
        "gist": "持經功德,勝於恒河沙數世界七寶布施。"
      },
      {
        "id": "012",
        "name": "尊重正教分",
        "gist": "隨說此經之處,一切天人皆應供養,如佛塔廟。"
      },
      {
        "id": "013",
        "name": "如法受持分",
        "gist": "此經名為金剛般若;佛說般若,即非般若。"
      },
      {
        "id": "014",
        "name": "離相寂滅分",
        "gist": "離一切相,即名諸佛;聞經不驚不怖,是為希有。"
      },
      {
        "id": "015",
        "name": "持經功德分",
        "gist": "為他人解說此經,功德無量,是人荷擔如來。"
      },
      {
        "id": "016",
        "name": "能淨業障分",
        "gist": "持經若為人輕賤,能滅先世罪業,終得菩提。"
      },
      {
        "id": "017",
        "name": "究竟無我分",
        "gist": "實無有法發菩提心;菩薩通達無我法者,是真菩薩。"
      },
      {
        "id": "018",
        "name": "一體同觀分",
        "gist": "如來具五眼,悉知眾生種種心,皆為非心,是名為心。"
      },
      {
        "id": "019",
        "name": "法界通化分",
        "gist": "因福德無實,故如來說得福德多。"
      },
      {
        "id": "020",
        "name": "離色離相分",
        "gist": "不應以具足色身、具足諸相見如來。"
      },
      {
        "id": "021",
        "name": "非說所說分",
        "gist": "如來實無所說法;眾生眾生者,如來說即非眾生。"
      },
      {
        "id": "022",
        "name": "無法可得分",
        "gist": "佛於阿耨菩提,實無少法可得,是名菩提。"
      },
      {
        "id": "023",
        "name": "淨心行善分",
        "gist": "是法平等,無有高下;修一切善法,即得菩提。"
      },
      {
        "id": "024",
        "name": "福智無比分",
        "gist": "持經四句偈之福,勝須彌山王七寶布施。"
      },
      {
        "id": "025",
        "name": "化無所化分",
        "gist": "如來實無眾生可度;凡夫者,即非凡夫。"
      },
      {
        "id": "026",
        "name": "法身非相分",
        "gist": "不可以三十二相見如來;若以色見聲求,是行邪道。"
      },
      {
        "id": "027",
        "name": "無斷無滅分",
        "gist": "發菩提心者,於一切法不說斷滅之相。"
      },
      {
        "id": "028",
        "name": "不受不貪分",
        "gist": "菩薩不受福德,於所作福德不應貪著。"
      },
      {
        "id": "029",
        "name": "威儀寂淨分",
        "gist": "如來無所從來,亦無所去,故名如來。"
      },
      {
        "id": "030",
        "name": "一合理相分",
        "gist": "一合相即非一合相;凡夫之人,貪著其事。"
      },
      {
        "id": "031",
        "name": "知見不生分",
        "gist": "所言法相者,如來說即非法相,故不生法相之見。"
      },
      {
        "id": "032",
        "name": "應化非真分",
        "gist": "一切有為法,如夢幻泡影,如露亦如電,應作如是觀。"
      }
    ]
  }
}
